# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
# On Colab, put the two *secret* values in the Secrets panel (key icon) under the same names.

# --- Identities (public, not secret) ---
HF_USERNAME=            # your Hugging Face username, e.g. jdoe
GITHUB_USERNAME=        # your GitHub username (owner of the microduck-challenges fork)
WANDB_ENTITY=           # your W&B username or team name
WANDB_PROJECT=microduck-arena

# --- Challenge being worked on ---
CHALLENGE_FOLDER=hill_climb_1m5
ARENA_EVENT=hill-climb-1m5
TASK=Mjlab-HillClimb1m5-MicroDuck

# --- Storage ---
# Google Drive backup folder as seen from Colab after drive.mount('/content/drive')
GDRIVE_DIR=/content/drive/MyDrive/microduck
# Private HF repo prefix for checkpoints: <HF_USERNAME>/<HF_CKPT_PREFIX>-<run-name>
HF_CKPT_PREFIX=mjlab-hillclimb1m5-microduck

# --- Secrets (local .env + Colab Secrets only) ---
HF_TOKEN=               # https://huggingface.co/settings/tokens  -> type "Write"
WANDB_API_KEY=          # https://wandb.ai/authorize
# Pushing to your fork from this PC uses your normal git login (browser prompt), no token here.
